# Copy to .env and fill in. Never commit .env.

# --- Required ---
OPENAI_API_KEY=sk-...
pinecone_apikey=pcsk_...

# --- Optional: Weave / W&B tracing (omit to disable) ---
WANDB_API_KEY=
CYBERLAW_WEAVE_PROJECT=zzarcai/RAG Prompt Tracking
CYBERLAW_TRACING_ENABLED=false

# --- Optional: overrides (defaults shown) ---
CYBERLAW_PINECONE_INDEX=cyberlaw
CYBERLAW_PINECONE_NAMESPACE=ch33-atomic-v2
CYBERLAW_CHAT_MODEL=gpt-4o-mini
CYBERLAW_EMBED_MODEL=text-embedding-3-small
CYBERLAW_TOP_K=6
CYBERLAW_MAX_AGENT_STEPS=6
